{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "NYAYA Forensics default capability - core + dialog/fs/shell permissions.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    { "identifier": "fs:allow-read-text-file", "allow": [{ "path": "**" }] },
    { "identifier": "fs:allow-write-text-file", "allow": [{ "path": "**" }] },
    "shell:default"
  ]
}